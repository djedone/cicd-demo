[MASTER]
disable =
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    R0903,  # too-few-public-methods

[FORMAT]
max-line-length = 88

[DESIGN]
max-args = 7
max-locals = 15
max-returns = 6
max-branches = 12
max-statements = 50
max-parents = 7
max-attributes = 7
min-public-methods = 2
max-public-methods = 20

[MESSAGES CONTROL]
disable =
    missing-docstring,
    too-few-public-methods
