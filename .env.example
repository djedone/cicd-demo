# CI/CD Demo Environment Configuration
# Copy this file to .env and update the values

# Application Settings
ENVIRONMENT=development
FLASK_ENV=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://cicd_demo_user:localpass@localhost:5432/cicd_demo
# For production, use: postgresql://user:password@host:port/database

# Metrics and Monitoring
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s

# External Services
# RENDER_STAGING_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx/key
# RENDER_PROD_DEPLOY_HOOK=https://api.render.com/deploy/srv-yyyy/key

# Monitoring and Alerting
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/yyyyy/zzzzz
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Performance Testing
LOCUST_HOST=http://localhost:5000
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1
LOCUST_RUN_TIME=30s

# Docker Configuration
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_NAME=cicd-demo
